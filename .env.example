# Application Server Port & Environment
PORT=4000
NODE_ENV=development
STORAGE_MODE=local
TRUST_PROXY=false

# JWT Authentication Secret Key
JWT_SECRET=replace_with_a_random_32_byte_or_longer_secret

# MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=food_donation
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_ROOT_PASSWORD=your_mysql_root_password_for_docker
# For Cloud Database (Aiven / AWS RDS) with TLS/SSL:
MYSQL_SSL=false
# MYSQL_SSL_CA_PATH=./certs/ca.pem
# MYSQL_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"


# Amazon Web Services (AWS) S3 Storage Configuration
# Note: For production EC2 deployment, IAM Roles are preferred over long-lived keys.
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-food-donation-platform-s3-bucket
# Optional for local development only. Prefer AWS CLI profiles or IAM roles.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
